CLEX_ENV=production
# Set CLEX_METRICS_TOKEN (32-256 URL-safe random characters) in the secret store.
# Set a persistent random Base64 32-byte CLEX_BRIDGE_SECRET_KEY through the secret store.
# Back up this key separately with the database; preserve it across deployments.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clex_mqtt
CLEX_MQTT_ADDR=127.0.0.1:1883
CLEX_HTTP_ADDR=127.0.0.1:8085
CLEX_PUBLIC_URL=https://mqtt.example.com
CLEX_COOKIE_SECURE=true
# Trust only the exact local reverse-proxy addresses; Nginx must overwrite X-Real-IP.
CLEX_HTTP_TRUSTED_PROXY_IPS=127.0.0.1,::1
CLEX_TLS_ADDR=0.0.0.0:8883
CLEX_TLS_CERT_FILE=/etc/clex-mqtt/certs/fullchain.pem
CLEX_TLS_KEY_FILE=/etc/clex-mqtt/certs/privkey.pem
CLEX_TLS_CLIENT_AUTH=none
# For optional/required client certificates, set a dedicated client CA bundle:
# CLEX_TLS_CLIENT_CA_FILE=/etc/clex-mqtt/certs/client-ca.pem
CLEX_DB_MAX_CONNECTIONS=10
CLEX_MAX_PACKET_BYTES=1048576
CLEX_MAX_CONNECTIONS=1000
CLEX_MAX_INFLIGHT=32
CLEX_MAX_PENDING=10000
CLEX_MAX_PENDING_BYTES=67108864
CLEX_SHUTDOWN_TIMEOUT_SECS=10
RUST_LOG=clex_mqtt=info,tower_http=warn

# Public signup is opt-in. Disabling signup preserves existing account login.
CLEX_REGISTRATION_ENABLED=false
CLEX_MAX_ACCOUNTS=100
