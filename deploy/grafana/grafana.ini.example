[paths]
data = /var/lib/grafana
logs = /var/log/grafana
plugins = /var/lib/grafana/plugins
provisioning = /etc/grafana/provisioning

[server]
protocol = http
http_addr = 127.0.0.1
http_port = 3000
domain = mqtt.example.com
root_url = https://mqtt.example.com/grafana/
serve_from_sub_path = true

[security]
admin_user = admin
admin_password = $__file{/etc/grafana/secrets/admin-password}
secret_key = $__file{/etc/grafana/secrets/secret-key}
cookie_secure = true
cookie_samesite = strict
disable_gravatar = true
disable_brute_force_login_protection = false
brute_force_login_protection_max_attempts = 5
allow_embedding = false
data_source_proxy_whitelist = 127.0.0.1:9090

[users]
allow_sign_up = false
allow_org_create = false
auto_assign_org_role = Viewer

[auth]
login_cookie_name = clex_grafana_session

[auth.anonymous]
enabled = false

[analytics]
reporting_enabled = false
check_for_updates = false
check_for_plugin_updates = false

[plugins]
preinstall_disabled = true

[dashboards]
min_refresh_interval = 30s
default_home_dashboard_path = /etc/grafana/dashboards/broker.json

[unified_alerting]
enabled = false

[log]
mode = console
level = info
