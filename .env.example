CLEX_ENV=development
# Private metrics access. Prepare locally with python3 scripts/metrics_token.py
# CLEX_METRICS_TOKEN=
# Random Base64 32-byte key for encrypted bridge passwords. Generate locally:
# python3 scripts/bridge_key.py
# CLEX_BRIDGE_SECRET_KEY=
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clex_mqtt_dev
TEST_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clex_mqtt_test
SHADOW_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clex_mqtt_shadow
CLEX_CODEGEN_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/clex_mqtt_codegen
CLEX_MQTT_ADDR=127.0.0.1:1883
CLEX_HTTP_ADDR=127.0.0.1:8085
CLEX_PUBLIC_URL=http://127.0.0.1:8085
CLEX_COOKIE_SECURE=false
# Empty for direct HTTP access; only trust exact IPs of a configured reverse proxy.
CLEX_HTTP_TRUSTED_PROXY_IPS=
# Optional native MQTT TLS listener
# CLEX_TLS_ADDR=127.0.0.1:8883
# CLEX_TLS_CERT_FILE=certs/development/localhost.pem
# CLEX_TLS_KEY_FILE=certs/development/localhost.key
CLEX_TLS_CLIENT_AUTH=none
# CLEX_TLS_CLIENT_CA_FILE=certs/development/client-ca.pem
CLEX_DB_MAX_CONNECTIONS=10
CLEX_MAX_PACKET_BYTES=1048576
CLEX_MAX_CONNECTIONS=1000
CLEX_MAX_INFLIGHT=32
CLEX_MAX_PENDING=10000
CLEX_MAX_PENDING_BYTES=67108864
CLEX_ADMIN_USERNAME=admin
CLEX_ADMIN_PASSWORD=
RUST_LOG=clex_mqtt=info,tower_http=warn

# Public signup is opt-in. Disabling signup preserves existing account login.
CLEX_REGISTRATION_ENABLED=false
CLEX_MAX_ACCOUNTS=100
